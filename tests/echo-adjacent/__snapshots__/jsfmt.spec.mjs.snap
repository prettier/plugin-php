exports[`adjacent.php 1`] = `
====================================options=====================================
parsers: ["php"]
printWidth: 80
                                                                                | printWidth
=====================================input======================================
<?= $var1 ?><?= $var2 ?>
<?= $var1 ?><?= $var2 ?><?= $var3 ?>
<?php $a = 1; ?><?= $b ?>
<?= $a ?><?php echo $b; ?>
X<?= $a ?><?php $b = 1; ?>
<?= $a ?><?= $b ?> text

=====================================output=====================================
<?= $var1 ?><?= $var2 ?>
<?= $var1 ?><?= $var2 ?><?= $var3 ?>
<?php $a = 1; ?><?= $b ?>
<?= $a ?><?php echo $b; ?>
X<?= $a ?><?php $b = 1; ?>
<?= $a ?><?= $b ?> text

================================================================================
`;

exports[`alternate.php 1`] = `
====================================options=====================================
parsers: ["php"]
printWidth: 80
                                                                                | printWidth
=====================================input======================================
<?php if ($c): ?><?= $b ?><?php endif; ?>

