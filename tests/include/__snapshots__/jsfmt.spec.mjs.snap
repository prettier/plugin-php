// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`include.php 1`] = `
====================================options=====================================
parsers: ["php"]
printWidth: 80
                                                                                | printWidth
=====================================input======================================
<?php
namespace \\test\\testing;

include "test.php";
include_once "other.php";
require "test/test.php";
require_once "other/other.php";

include("test.php");
include_once("other.php");
require("test/test.php");
require_once("other/other.php");

if ((include 'vars.php') == TRUE) {
  echo 'OK';
}

if ((include ('vars.php')) == TRUE) {
    echo 'OK';
}

include 'php/product' . $variable . '.php';

include ( "test.php" );
include_once ( "other.php" );
require ( "test/test.php" );
require_once ( "other/other.php" );

include 'http://www.example.com/file.php?foo=1&bar=2';
include $filename;
(isset($_GET['p']) && $_GET['p'] === 'home') ? include 'pages/home.php' : '';
include Kohana::find_file('views', 'admin/system/errors');
include((("test.php")));
include('foo.php') . ' MORE OUTPUT';
include 'foo.php' . ' MORE OUTPUT';

=====================================output=====================================
<?php
namespace \\test\\testing;

include "test.php";
include_once "other.php";
require "test/test.php";
require_once "other/other.php";

include "test.php";
include_once "other.php";
require "test/test.php";
require_once "other/other.php";

if ((include "vars.php") == true) {
    echo "OK";
}

if ((include "vars.php") == true) {
    echo "OK";
}

include "php/product" . $variable . ".php";

include "test.php";
include_once "other.php";
require "test/test.php";
require_once "other/other.php";

include "http://www.example.com/file.php?foo=1&bar=2";
include $filename;
isset($_GET["p"]) && $_GET["p"] === "home" ? include "pages/home.php" : "";
include Kohana::find_file("views", "admin/system/errors");
include "test.php";
include "foo.php" . " MORE OUTPUT";
include "foo.php" . " MORE OUTPUT";

================================================================================
`;

exports[`invoke.php 1`] = `
====================================options=====================================
parsers: ["php"]
printWidth: 80
                                                                                | printWidth
=====================================input======================================
<?php
(include 'a.php')();
(require 'b.php')();
(include_once 'c.php')();
(require_once 'd.php')();
$x = (include 'e.php')->prop;
$y = (include 'f.php')['key'];
$z = (include 'g.php')?->method();
$w = (include 'h.php')::CONSTANT;

=====================================output=====================================
<?php
(include "a.php")();
(require "b.php")();
(include_once "c.php")();
(require_once "d.php")();
$x = (include "e.php")->prop;
$y = (include "f.php")["key"];
$z = (include "g.php")?->method();
$w = (include "h.php")::CONSTANT;

================================================================================
`;

exports[`single.php 1`] = `
====================================options=====================================
parsers: ["php"]
printWidth: 80
                                                                                | printWidth
=====================================input======================================
<?php
include "test.php";

=====================================output=====================================
<?php
include "test.php";

================================================================================
`;
