// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`braces.php 1`] = `
====================================options=====================================
parsers: ["php"]
printWidth: 80
                                                                                | printWidth
=====================================input======================================
<?php if (true) { // brace comment
  ?>
  <p>x</p>
  <?php
} ?>

=====================================output=====================================
<?php if (true) {
    // brace comment
    ?>
  <p>x</p>
  <?php } ?>

================================================================================
`;

exports[`if.php 1`] = `
====================================options=====================================
parsers: ["php"]
printWidth: 80
                                                                                | printWidth
=====================================input======================================
<?php if (true): // example comment
  ?>
  <h1>Heading</h1>
<?php endif; ?>

=====================================output=====================================
<?php if (true):
    // example comment
    ?>
  <h1>Heading</h1>
<?php endif; ?>

================================================================================
`;

exports[`while.php 1`] = `
====================================options=====================================
parsers: ["php"]
printWidth: 80
                                                                                | printWidth
=====================================input======================================
<?php while (have_posts()): // loop comment
  ?>
  <p>post</p>
<?php endwhile; ?>

=====================================output=====================================
<?php while (have_posts()):
    // loop comment
    ?>
  <p>post</p>
<?php endwhile; ?>

================================================================================
`;
